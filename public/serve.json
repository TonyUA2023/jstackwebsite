{
  "rewrites": [
    { "source": "/cotiza", "destination": "/cotiza/index.html" },
    { "source": "/gracias", "destination": "/gracias/index.html" },
    { "source": "/:path", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "{assets,fonts}/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
