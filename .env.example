# Copia este archivo como .env y completa solo lo que uses.
# Todas son públicas: Vite las incrusta en el JavaScript del navegador durante el build.

# --- Landing de captación (/cotiza/) ---
# ID del Píxel de Meta (solo números). Sin esto el píxel no se carga.
VITE_META_PIXEL_ID=
# URL del Web App de Google Apps Script (Google Sheets + aviso por correo), o un webhook de Make/Zapier/n8n.
VITE_LEAD_WEBHOOK_URL=
# Supabase (opcional, puede convivir con el webhook). Usa la clave "anon"/publishable, nunca la service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_TABLE=leads
# Enlace de Calendly para agendar llamada en /gracias/ (opcional; vacío = no se muestra).
VITE_CALENDLY_URL=
# Opcionales: por defecto usan los valores del sitio actual.
# VITE_WHATSAPP_NUMBER=16469804939
# VITE_GA_MEASUREMENT_ID=G-48V3T3GC6C
